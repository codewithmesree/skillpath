# --- DATABASE CONFIGURATION ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# --- AUTHENTICATION ---
# Generate a secure secret using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# --- PAYMENTS (RAZORPAY) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- ADMIN CREDENTIALS (INBUILT ADMIN PORTAL) ---
ADMIN_EMAIL=admin@skillpath.dev
ADMIN_PASSWORD=admin123

# --- APP CONFIG ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- REALTIME (PUSHER CHANNELS) ---
# Create a free Channels app at https://dashboard.pusher.com, then copy "App Keys".
# Also enable "Client events" is NOT required. Private channels are authorized via /api/pusher/auth.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
